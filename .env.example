# 复制为 .env 后按需修改；docker compose 会自动读取
#   cp .env.example .env

# ---- 对外 API Key（客户端用 Bearer）。留空 = 不鉴权（仅内网自用） ----
LONGCAT_API_KEY=sk-longcat-change-me

# ---- 宿主机映射端口 ----
PORT=8090

# ---- 镜像来源 ----
# IMAGE 只写「仓库地址」，tag 由 TAG 控制
#
# 官方（海外/代理环境最快）：
IMAGE=ghcr.io/xitihangto/longcat2api
# 国内加速（三选一，实测均可拉到 linux/amd64 + linux/arm64）：
# IMAGE=ghcr.1ms.run/xitihangto/longcat2api
# IMAGE=ghcr.nju.edu.cn/xitihangto/longcat2api
# IMAGE=ghcr.dockerproxy.net/xitihangto/longcat2api
#
# 懒得手挑就运行：./scripts/pull-image.sh   （会逐个试，成功者写回本文件）
#
# TAG：latest=跟随 main 最新构建；sha-<短哈希>=固定某次提交；v0.1.0=发版
TAG=latest

# ---- 账号：首次启动注入 token（导入成功后会落到 ./data/accounts.json，之后可删）----
# 获取：宿主机 `go run ./cmd/login` 后从 ./data/accounts.json 里取 token，或客户端里拷
LONGCAT_TOKEN=

# ---- 时区 / 运行用户 ----
TZ=Asia/Shanghai
# 留空 = root（免 chown，开箱即用）；要非 root 填宿主 uid/gid：PUID=$(id -u) PGID=$(id -g)
PUID=
PGID=

# ---- 仅本地构建 (docker compose up -d --build) 时需要 ----
# Go 模块代理
GOPROXY=https://goproxy.cn,direct
# 基础镜像（Docker Hub 拉不动时换成镜像站）
BASE_GO=golang:1.22-alpine
BASE_RUN=alpine:3.20
# BASE_GO=docker.m.daocloud.io/library/golang:1.22-alpine
# BASE_RUN=docker.m.daocloud.io/library/alpine:3.20

# ---- longcat-web 网页通道（免费 LongCat-2.5，免登录即可用）----
LONGCAT_WEB_ENABLED=true
LONGCAT_WEB_MODE=oversea
# 想要更稳/更高额度：浏览器登录 longcat.chat → F12 → 任意请求的 Cookie 头整串粘过来
LONGCAT_WEB_COOKIE=
# 两次请求最小间隔（毫秒）。上游限流很凶，别调太小
LONGCAT_WEB_MIN_INTERVAL_MS=1500

# ---- 可选：上游覆盖（一般不用动）----
# LONGCAT_MODEL=LongCat-2.0
# LONGCAT_CHAT_BASE=https://nocode.cn
# LONGCAT_STREAM_BASE=https://ai.catpaw.meituan.com
# LONGCAT_GATEWAY_BASE=https://catx.nocode.cn
# LONGCAT_LOG_REQUESTS=true
