# 复制为 .env 后按需修改；docker compose 会自动读取

# 对外 API Key（客户端 Bearer）。留空则用 config.json 里的 api_key
LONGCAT_API_KEY=sk-longcat-change-me

# 宿主机映射端口
PORT=8090

# 容器运行用户：留空 = root（挂载目录免 chown，开箱即用）
# 要非 root 就填宿主 uid/gid：PUID=$(id -u)  PGID=$(id -g)
PUID=
PGID=

TZ=Asia/Shanghai

# 首次启动注入的妙手 token（导入成功后可删）
# 获取方式（宿主机执行）：
#   go run ./cmd/login -token   # 或先 go run ./cmd/login 导入，再 cat data/accounts.json
LONGCAT_TOKEN=

# 构建时 Go 模块代理（国内建议 https://goproxy.cn,direct）
GOPROXY=https://proxy.golang.org,direct
TAG=0.1.0
